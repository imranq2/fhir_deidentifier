{
  "fhirVersion": "R4",
  "defaultRule": "redact",
  "processingErrors": "raise",
  "fhirPathRules": [
    {
      "path": "MedicationRequest.status",
      "method": "keep"
    },
    {
      "path": "MedicationRequest.intent",
      "method": "keep"
    },
    {
      "path": "MedicationRequest.category",
      "method": "keep"
    },
    {
      "path": "MedicationRequest.priority",
      "method": "keep"
    },
    {
      "path": "MedicationRequest.doNotPerform",
      "method": "keep"
    },
    {
      "path": "MedicationRequest.medication.ofType(CodeableConcept)",
      "method": "keep"
    },
    {
      "path": "MedicationRequest.subject.display",
      "method": "substitute",
      "replaceWith": "John Doe"
    },
    {
      "path": "MedicationRequest.encounter.display",
      "method": "substitute",
      "replaceWith": "Fake Encounter"
    },
    {
      "path": "MedicationRequest.authoredOn",
      "method": "dateShift"
    }
  ]
}
