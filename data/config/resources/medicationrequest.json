{
  "fhirVersion": "R4",
  "defaultRule": "redact",
  "processingErrors": "raise",
  "fhirPathRules": [
    {
      "path": "MedicationRequest.status",
      "method": "keep"
    },
    {
      "path": "MedicationRequest.intent",
      "method": "keep"
    },
    {
      "path": "MedicationRequest.category",
      "method": "keep"
    },
    {
      "path": "MedicationRequest.priority",
      "method": "keep"
    },
    {
      "path": "MedicationRequest.doNotPerform",
      "method": "keep"
    },
    {
      "path": "MedicationRequest.medication.ofType(CodeableConcept)",
      "method": "keep"
    },
    {
      "path": "MedicationRequest.authoredOn",
      "method": "dateShift"
    },
    {
      "path": "MedicationRequest.courseOfTherapyType.ofType(CodeableConcept)",
      "method": "keep"
    },
    {
      "path": "MedicationRequest.dosageInstruction.timing.event",
      "method": "dateShift"
    },
    {
      "path": "MedicationRequest.dosageInstruction.timing.repeat.bounds.ofType(Period)",
      "method": "dateShift"
    },
    {
      "path": "MedicationRequest.dosageInstruction.timing.repeat.duration",
      "method": "keep"
    },
    {
      "path": "MedicationRequest.dosageInstruction.timing.repeat.durationUnit",
      "method": "keep"
    },
    {
      "path": "MedicationRequest.dosageInstruction.timing.count",
      "method": "keep"
    },
    {
      "path": "MedicationRequest.reasonCode",
      "method": "keep"
    },
    {
      "path": "MedicationRequest.note.text",
      "method": "substitute",
      "replaceWith": "Redacted note"
    },
    {
      "path": "MedicationRequest.dosageInstruction.text",
      "method": "substitute",
      "replaceWith": "Redacted dosage"
    }
  ]
}
