{
  "fhirVersion": "R4",
  "processingErrors": "raise",
  "fhirPathRules": [
    {
      "path": "Patient.active",
      "method": "keep"
    },
    {
      "path": "Patient.nodesByType('HumanName').use",
      "method": "keep"
    },
    {
      "path": "Patient.nodesByType('HumanName').text",
      "method": "substitute",
      "replaceWith": "John Doe"
    },
    {
      "path": "Patient.nodesByType('HumanName').family",
      "method": "substitute",
      "replaceWith": "Doe"
    },
    {
      "path": "Patient.nodesByType('HumanName').given",
      "method": "substitute",
      "replaceWith": "John"
    },
    {
      "path": "Patient.nodesByType('ContactPoint').where(system='phone').use | Patient.nodesByType('ContactPoint').where(system='email').use",
      "method": "keep"
    },
    {
      "path": "Patient.nodesByType('ContactPoint').where(system='phone').system | Patient.nodesByType('ContactPoint').where(system='email').system",
      "method": "keep"
    },
    {
      "path": "Patient.nodesByType('ContactPoint').where(system='phone').value",
      "method": "substitute",
      "replaceWith": "111-111-1111"
    },
    {
      "path": "Patient.nodesByType('ContactPoint').where(system='email').value",
      "method": "substitute",
      "replaceWith": "foo@bar.com"
    },
    {
      "path": "Patient.gender",
      "method": "keep"
    },
    {
      "path": "Patient.birthDate",
      "method": "dateshift"
    },
    {
      "path": "Patient.deceasedBoolean",
      "method": "keep"
    },
    {
      "path": "Patient.nodesByType('Address').use",
      "method": "keep"
    },
    {
      "path": "Patient.nodesByType('Address').line",
      "method": "substitute",
      "replaceWith": "123 Fake Street"
    },
    {
      "path": "Patient.nodesByType('Address').city",
      "method": "substitute",
      "replaceWith": "Fake Town"
    },
    {
      "path": "Patient.nodesByType('Address').district",
      "method": "substitute",
      "replaceWith": "Fake District"
    },
    {
      "path": "Patient.nodesByType('Address').state",
      "method": "substitute",
      "replaceWith": "CA"
    },
    {
      "path": "Patient.nodesByType('Address').postalCode",
      "method": "substitute",
      "replaceWith": "12345"
    },
    {
      "path": "Patient.nodesByName('generalPractitioner').type",
      "method": "keep"
    },
    {
      "path": "Patient.generalPractitioner.display",
      "method": "substitute",
      "replaceWith": "Fake Doctor, MD"
    },
    {
      "path": "Patient.generalPractitioner.reference",
      "method": "substitute",
      "replaceWith": "Practitioner/1111111111111111"
    }
  ]
}
