{
  "fhirVersion": "R4",
  "defaultRule": "redact",
  "processingErrors": "raise",
  "fhirPathRules": [
    {
      "path": "Resource.id",
      "method": "keep"
    },
    {
      "path": "Resource.meta.id",
      "method": "keep"
    },
    {
      "path": "Resource.meta.versionId",
      "method": "keep"
    },
    {
      "path": "Resource.meta.lastUpdated",
      "method": "keep"
    },
    {
      "path": "Resource.meta.security.system",
      "method": "keep"
    },
    {
      "path": "Resource.meta.security.where(system='https://www.icanbwell.com/owner').code",
      "method": "substitute",
      "replaceWith": "deidentified"
    },
    {
      "path": "Resource.meta.security.where(system='https://www.icanbwell.com/access').code",
      "method": "substitute",
      "replaceWith": "deidentified"
    },
    {
      "path": "Resource.meta.security.where(system='https://www.icanbwell.com/vendor').code",
      "method": "substitute",
      "replaceWith": "deidentified"
    },
    {
      "path": "Resource.meta.security.where(system='https://www.icanbwell.com/sourceAssigningAuthority').code",
      "method": "substitute",
      "replaceWith": "deidentified"
    },
    {
      "path": "Resource.meta.security.where(system='https://www.icanbwell.com/connectionType').code",
      "method": "keep"
    },
    {
      "path": "Resource.identifier.where(system='https://www.icanbwell.com/uuid')",
      "method": "keep"
    },
    {
      "path": "nodesByType('Extension').where(url='https://www.icanbwell.com/uuid')",
      "method": "keep"
    },
    {
      "path": "nodesByType('Reference').where(reference.substring(reference.indexOf('/') + 1).matches('[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}')).reference",
      "method": "keep"
    }
  ],
  "parameters": {
    "dateShiftKey": "",
    "dateShiftScope": "file",
    "cryptoHashKey": "",
    "encryptKey": "",
    "enablePartialAgesForRedact": true,
    "enablePartialDatesForRedact": false,
    "enablePartialZipCodesForRedact": true,
    "restrictedZipCodeTabulationAreas": [
      "036",
      "059",
      "102",
      "203",
      "205",
      "369",
      "556",
      "692",
      "821",
      "823",
      "878",
      "879",
      "884",
      "893"
    ]
  }
}

