{
  "fhirVersion": "R4",
  "processingErrors": "raise",
  "fhirPathRules": [
    {
      "path": "Person.active",
      "method": "keep"
    },
    {
      "path": "Person.nodesByType('HumanName').use",
      "method": "keep"
    },
    {
      "path": "Person.nodesByType('HumanName').text",
      "method": "substitute",
      "replaceWith": "John Doe"
    },
    {
      "path": "Person.nodesByType('HumanName').family",
      "method": "substitute",
      "replaceWith": "Doe"
    },
    {
      "path": "Person.nodesByType('HumanName').given",
      "method": "substitute",
      "replaceWith": "John"
    },
    {
      "path": "Person.nodesByType('ContactPoint').where(system='phone').use | Person.nodesByType('ContactPoint').where(system='email').use",
      "method": "keep"
    },
    {
      "path": "Person.nodesByType('ContactPoint').where(system='phone').system | Person.nodesByType('ContactPoint').where(system='email').system",
      "method": "keep"
    },
    {
      "path": "Person.nodesByType('ContactPoint').where(system='phone').value",
      "method": "substitute",
      "replaceWith": "111-111-1111"
    },
    {
      "path": "Person.nodesByType('ContactPoint').where(system='email').value",
      "method": "substitute",
      "replaceWith": "foo@bar.com"
    },
    {
      "path": "Person.gender",
      "method": "keep"
    },
    {
      "path": "Person.birthDate",
      "method": "dateshift"
    },
    {
      "path": "Person.deceasedBoolean",
      "method": "keep"
    },
    {
      "path": "Person.nodesByType('Address').use",
      "method": "keep"
    },
    {
      "path": "Person.nodesByType('Address').line",
      "method": "substitute",
      "replaceWith": "123 Fake Street"
    },
    {
      "path": "Person.nodesByType('Address').city",
      "method": "substitute",
      "replaceWith": "Fake Town"
    },
    {
      "path": "Person.nodesByType('Address').district",
      "method": "substitute",
      "replaceWith": "Fake District"
    },
    {
      "path": "Person.nodesByType('Address').state",
      "method": "substitute",
      "replaceWith": "CA"
    },
    {
      "path": "Person.nodesByType('Address').postalCode",
      "method": "substitute",
      "replaceWith": "12345"
    },
    {
      "path": "Person.link.id",
      "method": "keep"
    },
    {
      "path": "Person.link.assurance",
      "method": "keep"
    },
    {
      "path": "Person.link.where(target.reference.startsWith('Patient/')).target.reference",
      "method": "substitute",
      "replaceWith": "Patient/REDACTED"
    },
    {
      "path": "Person.link.where(target.reference.startsWith('Person/')).target.reference",
      "method": "substitute",
      "replaceWith": "Person/REDACTED"
    }
  ]
}
