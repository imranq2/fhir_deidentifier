{
  "fhirPathRules": [
    {
      "id": "extension-rule-1",
      "path": "nodesByType('Extension').where(url='https://www.icanbwell.com/uuid')",
      "method": "keep"
    },
    {
      "id": "extension-rule-1",
      "path": "nodesByType('Extension').where(url='https://www.icanbwell.com/sourceId').id",
      "method": "keep"
    },
    {
      "id": "extension-rule-1",
      "path": "nodesByType('Extension').where(url='https://www.icanbwell.com/sourceAssigningAuthority').id",
      "method": "keep"
    },
    {
      "id": "extension-rule-2",
      "path": "nodesByType('Extension').where(url='https://fhir.icanbwell.com/4_0_0/StructureDefinition/intelligence')",
      "method": "keep"
    },
    {
      "id": "extension-rule-4",
      "path": "nodesByType('Extension').url",
      "method": "keep"
    },
    {
      "id": "extension-rule-3",
      "comment": "Redact Coding nodes within untrusted extensions here otherwise they cause problems later on",
      "path": "nodesByType('Extension').where(url.exists() and url.matches('{{TRUSTED_CODE_SYSTEMS}}'))",
      "method": "keep"
    },
    {
      "id": "extension-rule-3",
      "comment": "Redact Coding nodes within untrusted extensions here otherwise they cause problems later on",
      "path": "nodesByType('Extension').where(url.exists() and url.matches('{{TRUSTED_CODE_SYSTEMS}}').not()).nodesByType('instant')",
      "method": "dateShift"
    },
    {
      "id": "extension-rule-3",
      "comment": "Redact Coding nodes within untrusted extensions here otherwise they cause problems later on",
      "path": "nodesByType('Extension').where(url.exists() and url.matches('{{TRUSTED_CODE_SYSTEMS}}').not()).nodesByType('dateTime')",
      "method": "dateShift"
    },
    {
      "id": "extension-rule-3",
      "comment": "Redact Coding nodes within untrusted extensions here otherwise they cause problems later on",
      "path": "nodesByType('Extension').where(url.exists() and url.matches('{{TRUSTED_CODE_SYSTEMS}}').not()).nodesByType('date')",
      "method": "dateShift"
    },
    {
      "id": "extension-rule-3",
      "comment": "Redact Coding nodes within untrusted extensions here otherwise they cause problems later on",
      "path": "nodesByType('Extension').where(url.exists() and url.matches('{{TRUSTED_CODE_SYSTEMS}}').not()).nodesByType('time')",
      "method": "dateShift"
    },
    {
      "id": "extension-rule-3",
      "comment": "Redact Coding nodes within untrusted extensions here otherwise they cause problems later on",
      "path": "nodesByType('Extension').where(url.exists() and url.matches('{{TRUSTED_CODE_SYSTEMS}}').not()).nodesByType('Quantity')",
      "method": "keep"
    },
    {
      "id": "extension-rule-3",
      "comment": "Redact Coding nodes within untrusted extensions here otherwise they cause problems later on",
      "path": "nodesByType('Extension').where(url.exists() and url.matches('{{TRUSTED_CODE_SYSTEMS}}').not()).nodesByType('CodeableConcept').text",
      "method": "substitute",
      "replaceWith": "Redacted text"
    },
    {
      "id": "extension-rule-3",
      "comment": "Redact Coding nodes within untrusted extensions here otherwise they cause problems later on",
      "path": "nodesByType('Extension').where(url.exists() and url.matches('{{TRUSTED_CODE_SYSTEMS}}').not()).nodesByType('Coding').display",
      "method": "substitute",
      "replaceWith": "masked"
    },
    {
      "id": "extension-rule-3",
      "comment": "Redact Coding nodes within untrusted extensions here otherwise they cause problems later on",
      "path": "nodesByType('Extension').where(url.exists() and url.matches('{{TRUSTED_CODE_SYSTEMS}}').not()).nodesByType('Coding').system",
      "method": "substitute",
      "replaceWith": "http://terminology.hl7.org/CodeSystem/data-absent-reason"
    },
    {
      "id": "extension-rule-3",
      "comment": "Redact Coding nodes within untrusted extensions here otherwise they cause problems later on",
      "path": "nodesByType('Extension').where(url.exists() and url.matches('{{TRUSTED_CODE_SYSTEMS}}').not()).nodesByType('Coding').code",
      "method": "substitute",
      "replaceWith": "masked"
    },
    {
      "id": "extension-rule-3",
      "comment": "Redact Coding nodes within untrusted extensions here otherwise they cause problems later on",
      "path": "nodesByType('Extension').where(url.exists() and url.matches('{{TRUSTED_CODE_SYSTEMS}}').not()).valueCode",
      "method": "substitute",
      "replaceWith": "masked"
    },
    {
      "id": "extension-rule-3",
      "comment": "Redact Coding nodes within untrusted extensions here otherwise they cause problems later on",
      "path": "nodesByType('Extension').where(url.exists() and url.matches('{{TRUSTED_CODE_SYSTEMS}}').not()).nodesByType('Identifier')",
      "method": "substitute",
      "replaceWith": {
        "system": "http://terminology.hl7.org/CodeSystem/data-absent-reason",
        "value": "masked"
      }
    },
    {
      "id": "extension-rule-3",
      "comment": "Redact Coding nodes within untrusted extensions here otherwise they cause problems later on",
      "path": "nodesByType('Extension').where(url.exists() and url.matches('{{TRUSTED_CODE_SYSTEMS}}').not()).valueIdentifier",
      "method": "substitute",
      "replaceWith": {
        "system": "http://terminology.hl7.org/CodeSystem/data-absent-reason",
        "value": "masked"
      }
    },
    {
      "id": "extension-rule-3",
      "comment": "Redact Coding nodes within untrusted extensions here otherwise they cause problems later on",
      "path": "nodesByType('Extension').where(url.exists() and url.matches('{{TRUSTED_CODE_SYSTEMS}}').not()).nodesByType('string')",
      "method": "substitute",
      "replaceWith": "redacted"
    },
    {
      "id": "extension-rule-3",
      "comment": "Now hash the entire extension to catch any other sensitive data",
      "path": "nodesByType('Extension').where(url.exists() and url.matches('{{TRUSTED_CODE_SYSTEMS}}').not())",
      "method": "cryptoHash"
    }
  ]
}
