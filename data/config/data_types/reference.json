{
  "fhirPathRules": [
    {
      "path": "nodesByType('Reference').where(reference.substring(reference.indexOf('/') + 1).matches('[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}')).reference",
      "method": "keep"
    },
    {
      "path": "nodesByType('Reference').where(reference.matches('^[A-Za-z]+/.+$')).reference",
      "method": "cryptoHash"
    },
    {
      "path": "nodesByType('Reference').where(reference.matches('^Practitioner/.+$')).display",
        "method": "generalize",
      "cases": {
        "$this.matches('^[A-Ea-e0-1].*')": "'Anonymous-A'",
        "$this.matches('^[F-Jf-j2-3].*')": "'Anonymous-B'",
        "$this.matches('^[K-Ok-o4-5].*')": "'Anonymous-C'",
        "$this.matches('^[P-Tp-t6-7].*')": "'Anonymous-D'",
        "$this.matches('^[U-Zu-z8-9].*')": "'Anonymous-E'"
      }
    },
    {
      "path": "nodesByType('Reference').where(reference.matches('^Patient/.+$')).display",
      "method": "substitute",
      "replaceWith": "Jane Doe"
    }
  ]
}
