{
  "fhirVersion": "R4",
  "processingErrors": "raise",
  "fhirPathRules": [
    {
      "path": "nodesByType('CodeableConcept').text",
      "method": "substitute",
      "replaceWith": "substituted text"
    },
    {
      "path": "nodesByType('CodeableConcept').coding.display",
      "method": "substitute",
      "replaceWith": "substituted display"
    },
    {
      "path": "nodesByType('CodeableConcept').coding.code",
      "method": "keep"
    },
    {
      "path": "nodesByType('CodeableConcept').coding.system",
      "method": "keep"
    }
  ]
}
