{
  "fhirVersion": "R4",
  "processingErrors": "raise",
  "fhirPathRules": [
    {
      "path": "nodesByType('CodeableConcept').text",
      "method": "substitute",
      "replaceWith": "Redacted text"
    },
    {
      "path": "nodesByType('CodeableConcept').coding.where(system.startsWith('http://snomed.info') or system.startsWith('http://terminology.hl7.org')).display",
      "method": "keep"
    },
    {
      "path": "nodesByType('CodeableConcept').coding.display",
      "method": "substitute",
      "replaceWith": "Redacted display"
    },
    {
      "path": "nodesByType('CodeableConcept').coding.code",
      "method": "keep"
    },
    {
      "path": "nodesByType('CodeableConcept').coding.system",
      "method": "keep"
    }
  ]
}
