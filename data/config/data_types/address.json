{
  "fhirPathRules": [
    {
      "path": "nodesByType('Address').use",
      "method": "keep"
    },
    {
      "path": "nodesByType('Address').line",
      "method": "substitute",
      "replaceWith": "123 Main Street"
    },
    {
      "path": "nodesByType('Address').city",
      "method": "substitute",
      "replaceWith": "My Town"
    },
    {
      "path": "nodesByType('Address').district",
      "method": "substitute",
      "replaceWith": "My District"
    },
    {
      "path": "nodesByType('Address').state",
      "method": "substitute",
      "replaceWith": "CA"
    },
    {
      "path": "nodesByType('Address').postalCode",
      "method": "substitute",
      "replaceWith": "12345"
    }
  ]
}
