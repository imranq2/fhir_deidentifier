{
  "fhirPathRules": [
    {
      "path": "nodesByType('Identifier').where(system='https://www.icanbwell.com/uuid')",
      "method": "keep"
    },
    {
      "path": "nodesByType('Identifier').where(system='https://www.icanbwell.com/intelligence-layer-pipeline/version')",
      "method": "keep"
    },
    {
      "path": "nodesByType('Identifier').system",
      "method": "keep"
    },
    {
      "path": "nodesByType('Identifier').value",
      "method": "substitute",
      "replaceWith": "redacted"
    }
  ]
}
