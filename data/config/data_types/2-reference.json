{
  "fhirPathRules": [
    {
      "path": "nodesByType('Reference').where(reference.startsWith('Practitioner/') and (display.exists() and display.matches('^[A-Ea-e0-1].*') or display.empty()))",
      "method": "substitute",
      "replaceWith": {
        "reference": "Practitioner/{{PRACTITIONER_UUID_1}}",
        "display": "{{PRACTITIONER_NAME_1}}"
      }
    },
    {
      "path": "nodesByType('Reference').where(reference.startsWith('Practitioner/') and display.exists() and display.matches('^[F-Jf-j2-3].*'))",
      "method": "substitute",
      "replaceWith": {
        "reference": "Practitioner/{{PRACTITIONER_UUID_2}}",
        "display": "{{PRACTITIONER_NAME_2}}"
      }
    },
    {
      "path": "nodesByType('Reference').where(reference.startsWith('Practitioner/') and display.exists() and display.matches('^[K-Ok-o4-5].*'))",
      "method": "substitute",
      "replaceWith": {
        "reference": "Practitioner/{{PRACTITIONER_UUID_3}}",
        "display": "{{PRACTITIONER_NAME_3}}"
      }
    },
    {
      "path": "nodesByType('Reference').where(reference.startsWith('Practitioner/') and display.exists() and display.matches('^[P-Tp-t6-7].*'))",
      "method": "substitute",
      "replaceWith": {
        "reference": "Practitioner/{{PRACTITIONER_UUID_4}}",
        "display": "{{PRACTITIONER_NAME_4}}"
      }
    },
    {
      "path": "nodesByType('Reference').where(reference.startsWith('Practitioner/') and display.exists() and display.matches('^[U-Zu-z8-9].*'))",
      "method": "substitute",
      "replaceWith": {
        "reference": "Practitioner/{{PRACTITIONER_UUID_5}}",
        "display": "{{PRACTITIONER_NAME_5}}"
      }
    },
    {
      "path": "nodesByType('Reference').where(reference.exists() and reference.matches('^Practitioner/.+$')).extension",
      "method": "redact"
    },
    {
      "path": "nodesByType('Reference').where(reference.exists() and reference.matches('^Patient/.+$')).display",
      "method": "substitute",
      "replaceWith": "{{SUBSTITUTE_PERSON_NAME}}"
    },
    {
      "path": "nodesByType('Reference').where(reference.exists() and reference.matches('^Person/{{PERSON_ID_TO_SUBSTITUTE}}'))",
      "method": "substitute",
      "replaceWith": {
        "reference": "Person/{{SUBSTITUTE_PERSON_ID}}",
        "display": "{{SUBSTITUTE_PERSON_NAME}}"
      }
    },
    {
      "path": "nodesByType('Reference').where(reference.exists() and reference.matches('^Person/.+$')).display",
      "method": "substitute",
      "replaceWith": "{{SUBSTITUTE_PERSON_NAME}}"
    },
    {
      "path": "nodesByType('Reference').where(reference.startsWith('Organization/') and (display.exists() and display.matches('^[A-Oa-o0-4].*') or display.empty()))",
      "method": "substitute",
      "replaceWith": {
        "reference": "Organization/{{ORGANIZATION_UUID_1}}",
        "display": "{{ORGANIZATION_NAME_1}}"
      }
    },
    {
      "path": "nodesByType('Reference').where(reference.startsWith('Organization/') and display.exists() and display.matches('^[P-Zp-z5-9].*'))",
      "method": "substitute",
      "replaceWith": {
        "reference": "Organization/{{ORGANIZATION_UUID_2}}",
        "display": "{{ORGANIZATION_NAME_2}}"
      }
    },
    {
      "path": "nodesByType('Reference').where(reference.startsWith('Location/') and (display.exists() and display.matches('^[A-Oa-o0-4].*') or display.empty()))",
      "method": "substitute",
      "replaceWith": {
        "reference": "Location/{{LOCATION_UUID_1}}",
        "display": "{{LOCATION_NAME_1}}"
      }
    },
    {
      "path": "nodesByType('Reference').where(reference.startsWith('Location/') and display.exists() and display.matches('^[P-Zp-z5-9].*'))",
      "method": "substitute",
      "replaceWith": {
        "reference": "Location/{{LOCATION_UUID_2}}",
        "display": "{{LOCATION_NAME_2}}"
      }
    },
    {
      "path": "nodesByType('Reference').where(reference.exists() and reference.substring(reference.indexOf('/') + 1).matches('[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}')).reference",
      "method": "keep"
    },
    {
      "path": "nodesByType('Reference').where(reference.exists() and reference.matches('^[A-Za-z]+/.+$')).reference",
      "method": "cryptoHash"
    }
  ]
}
