{
  "fhirPathRules": [
    {
      "path": "nodesByType('Reference').where(reference.substring(reference.indexOf('/') + 1).matches('[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}')).reference",
      "method": "keep"
    },
    {
      "path": "nodesByType('Reference').where(reference.matches('^Practitioner/.+$')).display",
      "method": "generalize",
      "cases": {
        "$this.matches('^[A-Ea-e0-1].*')": "'{{PRACTITIONER_NAME_1}}'",
        "$this.matches('^[F-Jf-j2-3].*')": "'{{PRACTITIONER_NAME_2}}'",
        "$this.matches('^[K-Ok-o4-5].*')": "'{{PRACTITIONER_NAME_3}}'",
        "$this.matches('^[P-Tp-t6-7].*')": "'{{PRACTITIONER_NAME_4}}'",
        "$this.matches('^[U-Zu-z8-9].*')": "'{{PRACTITIONER_NAME_5}}'"
      }
    },
    {
      "path": "nodesByType('Reference').where(reference.matches('^Practitioner/.+$')).reference",
      "method": "generalize",
      "cases": {
        "$this.matches('^Practitioner/.[A-Ea-e0-1].*')": "'Practitioner/{{PRACTITIONER_UUID_1}}'",
        "$this.matches('^Practitioner/.[F-Jf-j2-3].*')": "'Practitioner/{{PRACTITIONER_UUID_2}}'",
        "$this.matches('^Practitioner/.[K-Ok-o4-5].*')": "'Practitioner/{{PRACTITIONER_UUID_3}}'",
        "$this.matches('^Practitioner/.[P-Tp-t6-7].*')": "'Practitioner/{{PRACTITIONER_UUID_4}}'",
        "$this.matches('^Practitioner/.[U-Zu-z8-9].*')": "'Practitioner/{{PRACTITIONER_UUID_5}}'"
      }
    },
    {
      "path": "nodesByType('Reference').where(reference.matches('^Practitioner/.+$')).extension",
      "method": "redact"
    },
    {
      "path": "nodesByType('Reference').where(reference.matches('^Patient/.+$')).display",
      "method": "substitute",
      "replaceWith": "{{SUBSTITUTE_PERSON_NAME}}"
    },
    {
      "path": "nodesByType('Reference').where(reference.matches('^Person/.+$')).display",
      "method": "substitute",
      "replaceWith": "{{SUBSTITUTE_PERSON_NAME}}"
    },
    {
      "path": "nodesByType('Reference').where(reference.matches('^[A-Za-z]+/.+$')).reference",
      "method": "cryptoHash"
    }
  ]
}
