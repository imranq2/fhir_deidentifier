
{
  "fhirVersion": "R4",
  "processingErrors": "raise",
  "fhirPathRules": [
    {
      "path": "nodesByType('Coding').where(system.startsWith('http://snomed.info') or system.startsWith('http://terminology.hl7.org')).display",
      "method": "keep"
    },
    {
      "path": "nodesByType('Coding').display",
      "method": "substitute",
      "replaceWith": "Redacted display"
    },
    {
      "path": "nodesByType('Coding').code",
      "method": "keep"
    },
    {
      "path": "nodesByType('Coding').system",
      "method": "keep"
    }
  ]
}
