{
  "fhirPathRules": [
    {
      "path": "nodesByType('Coding').where(system.startsWith('http://snomed.info')).display",
      "method": "keep"
    },
    {
      "path": "nodesByType('Coding').where(system.startsWith('http://snomed.info')).code",
      "method": "keep"
    },
    {
      "path": "nodesByType('Coding').where(system.startsWith('http://terminology.hl7.org')).display",
      "method": "keep"
    },
    {
      "path": "nodesByType('Coding').where(system.startsWith('http://terminology.hl7.org')).code",
      "method": "keep"
    },
    {
      "path": "nodesByType('Coding').where(system.startsWith('http://loinc.org')).display",
      "method": "keep"
    },
    {
      "path": "nodesByType('Coding').where(system.startsWith('http://loinc.org')).code",
      "method": "keep"
    },
    {
      "path": "nodesByType('Coding').where(system.startsWith('http://www.nlm.nih.gov')).display",
      "method": "keep"
    },
    {
      "path": "nodesByType('Coding').where(system.startsWith('http://www.nlm.nih.gov')).code",
      "method": "keep"
    },
    {
      "path": "nodesByType('Coding').display",
      "method": "substitute",
      "replaceWith": "Redacted display"
    },
    {
      "path": "nodesByType('Coding').where(code.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}')).code",
      "method": "substitute",
      "replaceWith": "2000-01-01"
    },
    {
      "path": "nodesByType('Coding').code",
      "method": "substitute",
      "replaceWith": "redacted"
    },
    {
      "path": "nodesByType('Coding').system",
      "method": "keep"
    }
  ]
}
