{
  "fhirPathRules": [
    {
      "path": "nodesByType('Coding').where(system.startsWith('http://snomed.info')).display",
      "method": "keep"
    },
    {
      "path": "nodesByType('Coding').where(system.startsWith('http://snomed.info')).code",
      "method": "keep"
    },
    {
      "path": "nodesByType('Coding').where(system.startsWith('http://terminology.hl7.org')).display",
      "method": "keep"
    },
    {
      "path": "nodesByType('Coding').where(system.startsWith('http://terminology.hl7.org')).code",
      "method": "keep"
    },
    {
      "path": "nodesByType('Coding').where(system.startsWith('http://loinc.org')).display",
      "method": "keep"
    },
    {
      "path": "nodesByType('Coding').where(system.startsWith('http://loinc.org')).code",
      "method": "keep"
    },
    {
      "path": "nodesByType('Coding').where(system.startsWith('http://www.nlm.nih.gov')).display",
      "method": "keep"
    },
    {
      "path": "nodesByType('Coding').where(system.startsWith('http://www.nlm.nih.gov')).code",
      "method": "keep"
    },
    {
      "path": "nodesByType('Coding').where(system.startsWith('http://hl7.org')).display",
      "method": "keep"
    },
    {
      "path": "nodesByType('Coding').where(system.startsWith('http://hl7.org')).code",
      "method": "keep"
    },
    {
      "path": "nodesByType('Coding').where(system.startsWith('http://www.ama-assn.org')).display",
      "method": "keep"
    },
    {
      "path": "nodesByType('Coding').where(system.startsWith('http://www.ama-assn.org')).code",
      "method": "keep"
    },
    {
      "path": "nodesByType('Coding').where(system.startsWith('https://fhir.icanbwell.com/4_0_0/CodeSystem/medicationstatement')).display",
      "method": "keep"
    },
    {
      "path": "nodesByType('Coding').where(system.startsWith('https://fhir.icanbwell.com/4_0_0/CodeSystem/medicationstatement')).code",
      "method": "keep"
    },
    {
      "path": "nodesByType('Coding').where(system.startsWith('http://www.whocc.no/atc')).display",
      "method": "keep"
    },
    {
      "path": "nodesByType('Coding').where(system.startsWith('http://www.whocc.no/atc')).code",
      "method": "keep"
    },
    {
      "path": "nodesByType('Coding').display",
      "method": "substitute",
      "replaceWith": "Redacted display"
    },
    {
      "path": "nodesByType('Coding').where(code.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}')).code",
      "method": "substitute",
      "replaceWith": "2000-01-01"
    },
    {
      "path": "nodesByType('Coding').code",
      "method": "substitute",
      "replaceWith": "redacted"
    },
    {
      "path": "nodesByType('Coding').system",
      "method": "keep"
    }
  ]
}
