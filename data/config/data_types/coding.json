{
  "fhirPathRules": [
    {
      "id": "coding-rule-1",
      "path": "nodesByType('Coding').where(system.exists() and system.matches('^(http://|https://|urn:oid:)').not()).system",
      "method": "generalize",
      "cases": {
        "$this.exists()": "'urn:oid:' + $this"
      },
      "otherValues": "keep"
    },
    {
      "id": "coding-rule-2",
      "path": "nodesByType('Coding').where(system.exists() and system.matches('{{TRUSTED_CODE_SYSTEMS}}')).display",
      "method": "keep"
    },
    {
      "id": "coding-rule-3",
      "path": "nodesByType('Coding').where(system.exists() and system.matches('{{TRUSTED_CODE_SYSTEMS}}')).code",
      "method": "keep"
    },
    {
      "id": "coding-rule-4",
      "path": "nodesByType('Coding').display",
      "method": "substitute",
      "replaceWith": "Redacted display"
    },
    {
      "id": "coding-rule-5",
      "path": "nodesByType('Coding').where(code.exists() and code.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}')).code",
      "method": "substitute",
      "replaceWith": "2000-01-01"
    },
    {
      "id": "coding-rule-6",
      "path": "nodesByType('Coding').code",
      "method": "substitute",
      "replaceWith": "masked"
    },
    {
      "id": "coding-rule-7",
      "path": "nodesByType('Coding').system",
      "method": "substitute",
      "replaceWith": "http://terminology.hl7.org/CodeSystem/data-absent-reason"
    },
    {
      "id": "coding-rule-8",
      "path": "nodesByType('Coding').display",
      "method": "substitute",
      "replaceWith": "masked"
    }
  ]
}
