{
  "fhirVersion": "R4",
  "processingErrors": "raise",
  "fhirPathRules": [
    {
      "path": "nodesByType('Coding').where(system.startsWith('http://snomed.info') or system.startsWith('http://terminology.hl7.org') or system.startsWith('http://loinc.org')).display",
      "method": "keep"
    },
    {
      "path": "nodesByType('Coding').display",
      "method": "substitute",
      "replaceWith": "Redacted display"
    },
    {
      "path": "nodesByType('Coding').where(code.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}')).code",
      "method": "substitute",
      "replaceWith": "2000-01-01"
    },
    {
      "path": "nodesByType('Coding').code",
      "method": "keep"
    },
    {
      "path": "nodesByType('Coding').system",
      "method": "keep"
    }
  ]
}
