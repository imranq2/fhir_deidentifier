{
  "fhirPathRules": [
    {
      "path": "nodesByType('Coding').where(system.matches('https?://(snomed.info|terminology.hl7.org|loinc.org|www.nlm.nih.gov|hl7.org|www.ama-assn.org|fhir.icanbwell.com/4_0_0/CodeSystem/medicationstatement|www.whocc.no/atc)')).display",
      "method": "keep"
    },
    {
      "path": "nodesByType('Coding').where(system.matches('https?://(snomed.info|terminology.hl7.org|loinc.org|www.nlm.nih.gov|hl7.org|www.ama-assn.org|fhir.icanbwell.com/4_0_0/CodeSystem/medicationstatement|www.whocc.no/atc)')).code",
      "method": "keep"
    },
    {
      "path": "nodesByType('Coding').display",
      "method": "substitute",
      "replaceWith": "Redacted display"
    },
    {
      "path": "nodesByType('Coding').where(code.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}')).code",
      "method": "substitute",
      "replaceWith": "2000-01-01"
    },
    {
      "path": "nodesByType('Coding').code",
      "method": "substitute",
      "replaceWith": "redacted"
    },
    {
      "path": "nodesByType('Coding').system",
      "method": "keep"
    }
  ]
}
