{
  "fhirPathRules": [
    {
      "path": "nodesByType('Coding').where(system.matches('{{TRUSTED_CODE_SYSTEMS}}')).display",
      "method": "keep"
    },
    {
      "path": "nodesByType('Coding').where(system.matches('{{TRUSTED_CODE_SYSTEMS}}')).code",
      "method": "keep"
    },
    {
      "path": "nodesByType('Coding').display",
      "method": "substitute",
      "replaceWith": "Redacted display"
    },
    {
      "path": "nodesByType('Coding').where(code.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}')).code",
      "method": "substitute",
      "replaceWith": "2000-01-01"
    },
    {
      "path": "nodesByType('Coding').code",
      "method": "substitute",
      "replaceWith": "redacted"
    },
    {
      "path": "nodesByType('Coding').where(system.exists() and system.matches('^(http://|https://|urn:oid:)').not()).system",
      "method": "generalize",
      "cases": {
        "$this.exists()": "'urn:oid:' + $this"
      }
    },
    {
      "path": "nodesByType('Coding').system",
      "method": "keep"
    }
  ]
}
