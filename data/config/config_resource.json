{
  "fhirVersion": "R4",
  "processingErrors": "raise",
  "fhirPathRules": [
    { "path": "Resource.meta.security.where(system='https://www.icanbwell.com/owner').code", "method": "substitute", "replaceWith": "deidentified" },
    { "path": "Resource.meta.security.where(system='https://www.icanbwell.com/access').code", "method": "substitute", "replaceWith": "deidentified" },
    { "path": "Resource.meta.security.where(system='https://www.icanbwell.com/vendor').code", "method": "substitute", "replaceWith": "deidentified" },
    { "path": "Resource.meta.security.where(system='https://www.icanbwell.com/sourceAssigningAuthority').code", "method": "substitute", "replaceWith": "deidentified" },
    { "path": "Resource.meta.security.where(system='https://www.icanbwell.com/connectionType').code", "method": "keep" },
    { "path": "Resource.meta.security.code", "method": "cryptoHash" },
    { "path": "Resource.meta.source", "method": "cryptoHash" },
    { "path": "Resource.id", "method": "cryptoHash" },
    { "path": "Resource.patient.display", "method": "cryptoHash" },
    { "path": "Resource.subject.display", "method": "cryptoHash" }
  ],
  "parameters": {
    "dateShiftKey": "",
    "dateShiftScope": "file",
    "cryptoHashKey": "",
    "encryptKey": "",
    "enablePartialAgesForRedact": true,
    "enablePartialDatesForRedact": false,
    "enablePartialZipCodesForRedact": true,
    "restrictedZipCodeTabulationAreas": ["036","059","102","203","205","369","556","692","821","823","878","879","884","893"]
  }
}

